# Specify format for the log outputs
[logformat]
filename = msgs.log
datefmt = %%Y-%%d-%%m %%H:%%M:%%S
file_format= %%(asctime)s | %%(levelname)-8s | %%(message)s
file_level = INFO
cons_level = DEBUG
cons_format = %%(levelname)-8s | %%(message)s

[mallet]
mallet_path=/np-inferencer/src/core/models/mallet-2.0.8/bin/mallet

[restapi]
#Default setting for number of topics
batch_size=1000
corpus_col=corpus
date_field=date
no_meta_fields=raw_text,lemmas,bow,_version_,embeddings
searchable_fields=id,title,generative_objective,cpv,cpv_predicted,criterios_adjudicacion,criterios_solvencia,condiciones_especiales
thetas_max_sum=1000
betas_max_sum=1000
max_sum_neural_models=100000
path_source=/mnt/data_place

[inferencer]
thetas_thr=3e-3

[classifier]
cache_dir=/data/classifer/models

[embedder]
vector_size=200
window=5
min_count=10
sg=1
default_w2vec=word2vec-google-news-300
default_bert=all-MiniLM-L6-v2
max_sequence_length=384

# There will be one of this for each corpus avaialable
[sample-config]
id_field=place_id
title_field=title
date_field=date
MetadataDisplayed=id,title,link
SearcheableField=id,title

[place-config]
path_source=/mnt/data_place
id_field=id
title_field=title
date_field=updated
MetadataDisplayed=id,title,link,expediente,generative_objective
SearcheableField=id,title
embedding_text_fields=generative_objective,objeto
capabilities=metadata,semantic_by_text,semantic_by_document,indicators,cpv_filter
secondary_id_fields=expediente

[bdns-config]
path_source=/mnt/data_bdns
id_field=id
title_field=descripcion
date_field=fecha_registro
MetadataDisplayed=id,title,link,finalidad,organo_entidad,organo_ambito,presupuesto_total,plazo_fin_efectivo
SearcheableField=id,title,bases_reguladoras,organo_entidad,finalidad
embedding_text_fields=descripcion
capabilities=metadata,semantic_by_text,semantic_by_document
secondary_id_fields=codigo_bdns